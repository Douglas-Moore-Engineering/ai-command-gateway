@description('Azure resource region.')
param location string
@description('Generated resource name stem.')
param nameStem string
@description('Globally unique storage account name generated by the parent.')
param storageName string
@description('Nonproduction resource tags.')
param tags object
@description('Job managed identity principal ID.')
param principalId string
@description('Stable managed identity resource ID for role-assignment names, known before deployment. Recreating the identity requires deliberate role-assignment lifecycle review.')
param identityResourceId string
@description('Output Blob lifecycle age in days; raw inputs are excluded.')
param artifactRetentionDays int
@description('Private endpoint subnet ID.')
param privateEndpointSubnetId string
@description('Blob private DNS zone ID.')
param blobDnsZoneId string
@description('Diagnostic destination workspace resource ID.')
param workspaceId string

resource account 'Microsoft.Storage/storageAccounts@2025-01-01' = {
  // checkov:skip=CKV_AZURE_36:Private endpoints only; trusted-service bypass deliberately disabled. See infra/security-exceptions.md.
  // checkov:skip=CKV_AZURE_43:Parent generates staicg plus 13 lowercase alphanumeric uniqueString characters, 19 total. See infra/security-exceptions.md.
  // checkov:skip=CKV_AZURE_206:Standard_ZRS provides in-region replication; cross-region residency and recovery are not defined for this nonproduction workload. See infra/security-exceptions.md.
  name: storageName
  location: location
  tags: tags
  kind: 'StorageV2'
  sku: { name: 'Standard_ZRS' }
  properties: {
    accessTier: 'Hot'
    supportsHttpsTrafficOnly: true
    minimumTlsVersion: 'TLS1_2'
    publicNetworkAccess: 'Disabled'
    allowBlobPublicAccess: false
    allowSharedKeyAccess: false
    allowCrossTenantReplication: false
    defaultToOAuthAuthentication: true
    isLocalUserEnabled: false
    networkAcls: { defaultAction: 'Deny', bypass: 'None' }
    encryption: {
      keySource: 'Microsoft.Storage'
      requireInfrastructureEncryption: true
      services: {
        blob: { enabled: true, keyType: 'Account' }
        file: { enabled: true, keyType: 'Account' }
      }
    }
  }
}

resource blobs 'Microsoft.Storage/storageAccounts/blobServices@2025-01-01' = {
  parent: account
  name: 'default'
  properties: {
    isVersioningEnabled: true
    deleteRetentionPolicy: { enabled: true, days: 7 }
    containerDeleteRetentionPolicy: { enabled: true, days: 7 }
  }
}

resource inputs 'Microsoft.Storage/storageAccounts/blobServices/containers@2025-01-01' = {
  parent: blobs
  name: 'inputs'
  properties: { publicAccess: 'None' }
}

resource outputs 'Microsoft.Storage/storageAccounts/blobServices/containers@2025-01-01' = {
  parent: blobs
  name: 'outputs'
  properties: { publicAccess: 'None' }
}

resource inputReader 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(inputs.id, identityResourceId, 'blob-reader')
  scope: inputs
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '2a2b9908-6ea1-4ae2-8e65-a410df84e7d1')
    principalId: principalId
    principalType: 'ServicePrincipal'
  }
}

resource outputWriter 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(outputs.id, identityResourceId, 'blob-contributor')
  scope: outputs
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')
    principalId: principalId
    principalType: 'ServicePrincipal'
  }
}

resource lifecycle 'Microsoft.Storage/storageAccounts/managementPolicies@2025-01-01' = {
  parent: account
  name: 'default'
  properties: {
    policy: {
      rules: [{
        name: 'expire-derived-outputs'
        enabled: true
        type: 'Lifecycle'
        definition: {
          filters: { blobTypes: ['blockBlob'], prefixMatch: ['outputs/'] }
          actions: {
            baseBlob: { delete: { daysAfterModificationGreaterThan: artifactRetentionDays } }
            version: { delete: { daysAfterCreationGreaterThan: artifactRetentionDays } }
            snapshot: { delete: { daysAfterCreationGreaterThan: artifactRetentionDays } }
          }
        }
      }]
    }
  }
}

resource endpoint 'Microsoft.Network/privateEndpoints@2024-07-01' = {
  name: 'pep-${nameStem}-blob'
  location: location
  tags: tags
  properties: {
    subnet: { id: privateEndpointSubnetId }
    privateLinkServiceConnections: [{
      name: 'blob'
      properties: { privateLinkServiceId: account.id, groupIds: ['blob'] }
    }]
  }
}

resource dnsGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2024-07-01' = {
  parent: endpoint
  name: 'default'
  properties: {
    privateDnsZoneConfigs: [{ name: 'blob', properties: { privateDnsZoneId: blobDnsZoneId } }]
  }
}

resource diagnostics 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = {
  name: 'blob-access'
  scope: blobs
  properties: {
    workspaceId: workspaceId
    logAnalyticsDestinationType: 'Dedicated'
    logs: [
      { category: 'StorageRead', enabled: true }
      { category: 'StorageWrite', enabled: true }
      { category: 'StorageDelete', enabled: true }
    ]
  }
}

output accountName string = account.name
output accountUrl string = account.properties.primaryEndpoints.blob

