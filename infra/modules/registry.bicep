@description('Azure resource region.')
param location string
@description('Generated resource name stem.')
param nameStem string
@description('Globally unique registry name generated by the parent.')
param registryName string
@description('Nonproduction resource tags.')
param tags object
@description('Job managed identity principal ID.')
param principalId string
@description('Stable managed identity resource ID for role-assignment names, known before deployment. Recreating the identity requires deliberate role-assignment lifecycle review.')
param identityResourceId string
@description('Private endpoint subnet ID.')
param privateEndpointSubnetId string
@description('Registry private DNS zone ID.')
param registryDnsZoneId string
@description('Diagnostic destination workspace resource ID.')
param workspaceId string

resource registry 'Microsoft.ContainerRegistry/registries@2025-11-01' = {
  // checkov:skip=CKV_AZURE_166:Nonproduction controlled digest publication; automated quarantine scanning and release are deferred. See infra/security-exceptions.md.
  name: registryName
  location: location
  tags: tags
  sku: { name: 'Premium' }
  properties: {
    adminUserEnabled: false
    anonymousPullEnabled: false
    publicNetworkAccess: 'Disabled'
    networkRuleBypassOptions: 'None'
    networkRuleBypassAllowedForTasks: false
    roleAssignmentMode: 'LegacyRegistryPermissions'
    networkRuleSet: { defaultAction: 'Deny', ipRules: [] }
    dataEndpointEnabled: true
    policies: {
      // Required for Container Apps managed-identity image pulls.
      azureADAuthenticationAsArmPolicy: { status: 'enabled' }
      exportPolicy: { status: 'disabled' }
    }
  }
}

resource pull 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(registry.id, identityResourceId, 'acr-pull')
  scope: registry
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')
    principalId: principalId
    principalType: 'ServicePrincipal'
  }
}

resource endpoint 'Microsoft.Network/privateEndpoints@2024-07-01' = {
  name: 'pep-${nameStem}-registry'
  location: location
  tags: tags
  properties: {
    subnet: { id: privateEndpointSubnetId }
    privateLinkServiceConnections: [{
      name: 'registry'
      properties: { privateLinkServiceId: registry.id, groupIds: ['registry'] }
    }]
  }
}

resource dnsGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2024-07-01' = {
  parent: endpoint
  name: 'default'
  properties: {
    privateDnsZoneConfigs: [{ name: 'registry', properties: { privateDnsZoneId: registryDnsZoneId } }]
  }
}

resource diagnostics 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = {
  name: 'registry-access'
  scope: registry
  properties: {
    workspaceId: workspaceId
    logAnalyticsDestinationType: 'Dedicated'
    logs: [
      { category: 'ContainerRegistryRepositoryEvents', enabled: true }
      { category: 'ContainerRegistryLoginEvents', enabled: true }
    ]
  }
}

output registryName string = registry.name
output loginServer string = registry.properties.loginServer

