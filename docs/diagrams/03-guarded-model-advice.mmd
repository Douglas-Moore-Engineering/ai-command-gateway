  route -->|"yes"| preview
  route -->|"no; credential required"| api
  api -->|"untrusted output or failure"| recheck
  recheck -->|"current evidence and exact binding"| valid
  valid -->|"yes"| accepted
  valid -->|"no; reason retained"| fallback

