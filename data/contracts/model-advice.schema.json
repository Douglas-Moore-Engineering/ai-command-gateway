{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-command-gateway:model-advice:1",
  "title": "Guarded optional model observation round trip",
  "description": "Selected evidence is sent only after local retrieval succeeds. Accepted model claims are an exact permutation of local observations, reconstructed with local citations. Provider fallback and catalog rejection are explicit. No command authority is delegated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "response", "model", "request_preview"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "total_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "requested_model", "status", "reason_code", "attempted", "request_sha256", "response_id", "response_model", "usage"],
      "properties": {
        "provider": {"const": "openai"},
        "requested_model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "status": {"enum": ["skipped", "dry_run", "validated", "fallback", "rejected"]},
        "reason_code": {"enum": ["offline_abstention", "dry_run", "model_validated", "model_abstained", "invalid_provider_response", "claim_mismatch", "catalog_changed", "catalog_unverified", "provider_not_configured", "provider_timeout", "provider_http_error", "provider_unavailable", "provider_invalid_response", "provider_request_too_large", "provider_invalid_request"]},
        "attempted": {"type": "boolean", "description": "True for a network attempt or successful injected transport call, not proof of delivery. False for offline abstention, dry-run, or known preflight rejection."},
        "request_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "response_id": {"type": ["string", "null"], "pattern": "^resp_[A-Za-z0-9_-]{1,120}$"},
        "response_model": {"type": ["string", "null"], "maxLength": 160},
        "usage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/usage"}]}
      }
    },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "instructions", "input", "tools", "store", "stream", "reasoning", "max_output_tokens", "text"],
      "properties": {
        "model": {"type": "string"},
        "instructions": {"type": "string"},
        "input": {"type": "array", "minItems": 1, "maxItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["role", "content"],
          "properties": {
            "role": {"const": "user"},
            "content": {"type": "array", "minItems": 1, "maxItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["type", "text"],
              "properties": {"type": {"const": "input_text"}, "text": {"type": "string"}}
            }}
          }
        }},
        "tools": {"type": "array", "maxItems": 0},
        "store": {"const": false},
        "stream": {"const": false},
        "reasoning": {"type": "object", "additionalProperties": false, "required": ["effort"], "properties": {"effort": {"const": "low"}}},
        "max_output_tokens": {"type": "integer", "minimum": 256, "maximum": 4096},
        "text": {"type": "object", "required": ["format"], "additionalProperties": false, "properties": {
          "format": {"type": "object", "required": ["type", "name", "strict", "schema"], "additionalProperties": false,
                     "properties": {"type": {"const": "json_schema"}, "name": {"const": "cited_observations"},
                                    "strict": {"const": true}, "schema": {"type": "object"}}}
        }}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "mode": {"const": "guarded_model_advice"},
    "response": {"$ref": "advice.schema.json"},
    "model": {"$ref": "#/$defs/model"},
    "request_preview": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/preview"}]}
  },
  "allOf": [
    {"if": {"properties": {"model": {"properties": {"status": {"const": "dry_run"}}}}},
     "then": {"properties": {"request_preview": {"type": "object"}, "model": {"properties": {"attempted": {"const": false}, "reason_code": {"const": "dry_run"}}}}},
     "else": {"properties": {"request_preview": {"type": "null"}}}},
    {"if": {"properties": {"model": {"properties": {"status": {"const": "skipped"}}}}},
     "then": {"properties": {"model": {"properties": {"attempted": {"const": false}, "reason_code": {"const": "offline_abstention"}, "request_sha256": {"type": "null"}}}, "response": {"properties": {"response_type": {"const": "abstain"}}}}}},
    {"if": {"properties": {"model": {"properties": {"status": {"const": "validated"}}}}},
     "then": {"properties": {"model": {"properties": {"attempted": {"const": true}, "reason_code": {"const": "model_validated"}, "request_sha256": {"$ref": "#/$defs/sha256"}}}, "response": {"properties": {"response_type": {"const": "observation"}}}}}},
    {"if": {"properties": {"model": {"properties": {"status": {"const": "rejected"}}}}},
     "then": {"properties": {"response": {"properties": {"response_type": {"const": "abstain"}, "reason_code": {"const": "catalog_unverified"}, "claims": {"maxItems": 0}}}}}}
  ]
}
